# Konfigurasi Opsional Supabase Cloud (Aplikasi tetap berjalan 100% tanpa .env melalui penyimpanan lokal + seed data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opsional: Google Drive API Key (untuk live scan langsung folder 1Du4ZdTS22RuSDdP8Zr9_YVVKZud0_dlI dari browser)
VITE_GOOGLE_DRIVE_API_KEY=

# Opsional: Link Publish CSV Google Sheets atau Web App Google Apps Script
VITE_GOOGLE_SHEET_CSV_URL=

# PIN Admin Default untuk Panel Pustakawan (Default: 123456)
VITE_ADMIN_PIN=123456
